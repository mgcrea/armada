<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else about this app's Info.plist is INFOPLIST_KEY_* build
	     settings merged in at build time — GENERATE_INFOPLIST_FILE stays YES. The
	     keys here exist because none of them has an INFOPLIST_KEY_ spelling. -->

	<!-- The commit this bundle was built from, substituted from the
	     ARMADA_GIT_COMMIT build setting. CFBundleVersion is already the commit
	     COUNT, which orders builds but does not identify one: two branches at the
	     same depth share it. This is what turns a bug report into a diff.

	     Empty in an Xcode-only build, because Xcode has no git; `make build` and
	     CI both pass it. -->
	<key>ArmadaGitCommit</key>
	<string>$(ARMADA_GIT_COMMIT)</string>

	<!-- The feed, on our own site, which 302s to the latest GitHub release. Never
	     the release asset's own URL: this string is baked into every binary ever
	     shipped, which is exactly why it must be one we can repoint without asking
	     anyone to update first. `scripts/audit-network.sh` asserts this exact
	     value. -->
	<key>SUFeedURL</key>
	<string>https://armada.mgcrea.io/appcast.xml</string>

	<!-- The EdDSA public key every update is verified against.

	     ONE key signs bastion, cupertino and armada. Sparkle keeps a single signing
	     key per user account, not per app, so sharing it means one leaked key can
	     push an update to all three. That was decided again for armada on
	     2026-09-14 rather than inherited by accident.

	     Matched against both siblings' plists when it was added, and to be matched
	     against `generate_keys -p` before the first release: the copies agreeing
	     with the keychain is the check, not any one of them. -->
	<key>SUPublicEDKey</key>
	<string>hEZtsdbIsEdeSrWseZL5HriTCgDioKsEXqLIEsEFEd0=</string>

	<!-- Present and false, never absent. An ABSENT SUEnableAutomaticChecks is what
	     makes Sparkle show its own "check automatically?" prompt on second launch;
	     set explicitly, that prompt never appears and Armada asks in its own words
	     instead, with UpdateConsentCard. -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<!-- Never install without being asked. This app reads every agent transcript
	     on the Mac; a silent replacement of it is not something to enable by
	     default. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUSendProfileInfo</key>
	<false/>
	<!-- Not sandboxed, so the XPC services are stripped by `make sparkle`. Saying
	     so here too means a framework that regrows them still goes unused. -->
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>SUEnableDownloaderService</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
