---
/**
 * The licence terms, rendered as plain text, as both siblings render theirs.
 *
 * Read from `apps/apple/EULA` with `?raw`, as bastion and cupertino read theirs, so
 * the page and the file the app ships cannot disagree: this URL is what Stripe
 * Checkout links as the terms a buyer consents to. The text is bastion's agreement
 * with the product and its scope changed, not a new draft.
 *
 * `?raw`, not `readFileSync`: Vite resolves this against THIS file at build time
 * and inlines the bytes, where a runtime read would resolve against the bundled
 * chunk in dist/.
 */
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { APP_NAME, DOCS, REPO_PUBLIC, SELLING } from "../config";
import Layout from "../layouts/Layout.astro";

import eula from "../../../apple/EULA?raw";
---

<Layout
  title={`Licence terms · ${APP_NAME}`}
  description={`The end user licence agreement for the signed, notarized builds of ${APP_NAME}: one payment for every 1.x release on every Mac you own, offline validation, and a 30-day refund.`}
>
  <Nav />
  <main id="main" tabindex="-1" class="wrap py-20">
    <div class="mono text-accent">Terms</div>
    <h1 class="mt-3 mb-0 font-display text-[clamp(28px,4.4vw,40px)] font-semibold tracking-[-0.04em]">
      Licence terms
    </h1>
    {
      !SELLING && (
        <p class="mt-4 mb-0 max-w-[62ch] text-[16px] leading-[1.6] text-fg-dim text-pretty">
          {APP_NAME} is not on sale yet. These are the terms its first release is planned to ship
          under, published early so they can be read before anything is sold.
        </p>
      )
    }
    <p class="mt-4 mb-0 max-w-[62ch] text-[16px] leading-[1.6] text-fg-dim text-pretty">
      This covers the signed builds. The source is separate and has
      {
        REPO_PUBLIC ? (
          <a href={DOCS.sourceLicense} class="underline underline-offset-2">
            its own licence
          </a>
        ) : (
          "its own licence"
        )
      }.
    </p>
    <pre
      class="mt-10 mb-0 overflow-x-auto font-mono text-[13px] leading-[1.65] whitespace-pre-wrap text-fg/72">{eula}</pre>
  </main>
  <Footer />
</Layout>
