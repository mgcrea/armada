---
/**
 * What leaves your Mac, and what does not.
 *
 * Written as an inventory rather than a policy, as bastion's is, because for this
 * app the honest version is short: Armada makes one optional network request of
 * its own, the only personal data anything here stores is a purchase email, and
 * the feedback form sends what someone chooses to type.
 *
 * The claims are the ones SECURITY.md is being reworded to. If that file and this
 * page disagree, SECURITY.md is right and this page is stale.
 *
 * "This site" describes Cloudflare Web Analytics while CF_ANALYTICS_COUNTED is true,
 * which is whether a beacon runs. Armada's beacon is injected by Cloudflare at the
 * edge for the whole mgcrea.io zone; nothing in this repo renders one.
 *
 * A privacy page describing a counter that does not run is a false statement, and one
 * denying a counter that does run is a worse one.
 */
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import {
  APP_NAME,
  CF_ANALYTICS_COUNTED,
  DOCS,
  DOWNLOAD,
  FEEDBACK_API,
  FEEDBACK_URL,
  REPO_PUBLIC,
  SELLING,
  SITE_URL,
  SUPPORT_EMAIL,
  SUPPORT_EMAIL_HREF,
} from "../config";
import Layout from "../layouts/Layout.astro";

const updated = "15 September 2026";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy",
  url: `${SITE_URL}/privacy`,
  isPartOf: { "@id": `${SITE_URL}/#website` },
  publisher: { "@id": `${SITE_URL}/#organization` },
};

/** What the app sends, in full. Two entries, each started by you, and that is the point. */
const LEAVES = [
  {
    what: "An update check",
    when: "Only after you turn it on, or press Check Now.",
    body: `It reads one file, <code>${DOWNLOAD.appcast}</code>, which redirects to the latest release on GitHub. It sends no identifier with it: not your licence key, not a machine id. Your IP address is visible to the servers that answer, as it is for any download.`,
  },
  {
    what: "Voice's speech models",
    when: "Only when you press a Download button in Settings ▸ Voice.",
    body: "It fetches Parakeet v3, about 480 MB, or Kokoro, about 95 MB, each from huggingface.co and each from its own button, and sends no identifier with either. If another app has already put a model in FluidAudio's shared folders on your Mac, Armada uses that copy and downloads nothing. Your IP address is visible to the servers that answer, as it is for any download.",
  },
] as const;

/** What never leaves. Each of these is enforced somewhere nameable. */
const STAYS = [
  {
    what: "Your transcripts",
    body: "Armada reads the session files Claude Code and Codex already write, where they already are, in <code>~/.claude*</code> and <code>~/.codex</code>, and opens them read only. It has no connection of its own to send them over. The one way to read them from outside the app is the supervisor's MCP endpoint: off until you turn it on, on 127.0.0.1 only, for an agent you start or connect yourself.",
  },
  {
    what: "Your voice",
    body: "Only if you turn voice on. The microphone is on only while the card at the top of the screen says it is listening, your speech becomes text on your Mac, and the audio is never kept or sent. The question you asked goes on as text, through <code>claude</code>: see the programs it runs, below.",
  },
  {
    what: "Your vendor accounts",
    body: "Armada holds no vendor credentials. There is no sign-in, nothing reads or stores a token, and Codex's <code>auth.json</code> is never opened. The one thing it writes to Claude Code's configuration is the flag its own \"Yes, I trust this folder\" sets, for a project you saved, when you start a session there. Nothing else: no hook, no settings file, no MCP server entry, and nothing in Codex's.",
  },
  {
    what: "Your licence key",
    body: "Verified offline, on your Mac, with a signature check. No licence server is ever contacted by the app, so an installed copy has no idea who bought it.",
  },
  {
    what: "What Armada writes",
    body: "Only its own files: its preferences, usage history in <code>~/Library/Application Support/io.mgcrea.armada</code>, kept 30 days and deletable from Settings, and a startup script in its own temporary folder when you start a session, with the connection details beside it when that session is a supervisor. With voice on, it also keeps a folder per account where its <code>claude</code> records the conversation.",
  },
] as const;

const h2 = "m-0 font-display text-[22px] font-semibold tracking-[-0.03em]";
const lead = "mt-5 mb-0 max-w-[62ch] text-[15px] leading-[1.65] text-fg-dim text-pretty";
const prose = "mt-4 mb-0 max-w-[62ch] text-[15px] leading-[1.65] text-fg-dim text-pretty";
const note = "mt-5 mb-0 max-w-[62ch] text-[14px] leading-[1.6] text-fg-muted text-pretty";
const link = "underline underline-offset-2";
const code = "[&_code]:font-mono [&_code]:text-[0.9em] [&_code]:break-words [&_code]:text-fg/80";
---

<Layout
  title={`Privacy · ${APP_NAME}`}
  description="What leaves your Mac and what does not: one optional update check, no telemetry, no vendor credentials, and your agents' folders opened read only but for one trust flag."
  schema={schema}
>
  <Nav />
  <main id="main" tabindex="-1" class:list={["wrap py-20", code]}>
    <div class="mono text-accent">Privacy</div>
    <h1 class="mt-3 mb-0 font-display text-[clamp(28px,4.4vw,40px)] font-semibold tracking-[-0.04em]">
      Privacy
    </h1>
    <p class="mono mt-3 mb-0">Last updated {updated}</p>
    <p class="mt-6 mb-0 max-w-[62ch] text-[16px] leading-[1.6] text-fg-dim text-pretty">
      Armada reads every agent transcript on your Mac, across every account. The only defensible
      posture for that is to send nothing, and the only way to make the claim worth anything is to say
      what would falsify it.
    </p>

    <section class="mt-14">
      <h2 class={h2}>What the app sends</h2>
      <dl class="m-0 mt-6 flex flex-col gap-6">
        {
          LEAVES.map((item) => (
            <div class="flex flex-wrap items-start gap-x-10 gap-y-1 border-t border-rule pt-5">
              <dt class="flex flex-1 basis-[240px] flex-col gap-1">
                <span class="text-[15px] font-medium text-fg">{item.what}</span>
                <span class="text-[13px] text-fg-muted">{item.when}</span>
              </dt>
              <dd
                class="m-0 flex-[2] basis-[420px] text-[14.5px] leading-[1.65] text-fg-dim text-pretty"
                set:html={item.body}
              />
            </div>
          ))
        }
      </dl>
      <p class={note}>
        That is the whole list for Armada itself: no analytics, no telemetry, no crash reporter and no
        first-run ping. <code>make audit</code> checks it against every build. It sweeps every Mach-O
        in the built app for URL loading, DNS and TLS symbols, with two narrowly named exceptions,
        Sparkle for the update check and FluidAudio for the speech model downloads, and checks that the supervisor's MCP endpoint
        binds 127.0.0.1 and nothing else, and that the microphone is the app's only entitlement.
        {
          REPO_PUBLIC && (
            <>
              {" "}The script is{" "}
              <a href={DOCS.audit} rel="noopener" class={link}>
                scripts/audit-network.sh
              </a>
              , and you can run it against the copy you downloaded.
            </>
          )
        }
      </p>
      <p class={note}>
        Help ▸ Send Feedback is not a second entry. It opens the
        <a href={FEEDBACK_URL} class={link}>feedback form</a> in your browser with the app version,
        macOS version, Mac model and language in the address bar, and the app sends nothing itself.
      </p>
    </section>

    <section class="mt-16">
      <h2 class={h2}>The programs it runs</h2>
      <p class={lead}>
        To read plan limits, Armada runs your own installed <code>claude</code> and asks it a question
        that costs no tokens. That program talks to Anthropic over your own sign-in, under Anthropic's
        terms, as it does whenever you use it. The same is true of a session you start or fork from
        Armada: it runs <code>claude</code> or <code>codex</code> in your terminal, and what that agent
        does is between you and its vendor.
      </p>
      <p class={prose}>
        Voice, if you turn it on, is the one time Armada runs <code>claude</code> itself with a prompt:
        the question you just spoke, as text, on the account you chose. That <code>claude</code> gets no
        built-in tools and only Armada's read tools, and Armada closes it after five idle minutes.
      </p>
      <p class={prose}>
        Armada is not sandboxed. That is by design: it has to read other tools' folders, which a
        sandbox would refuse.
      </p>
    </section>

    <section class="mt-16">
      <h2 class={h2}>What never leaves</h2>
      <dl class="m-0 mt-6 flex flex-col gap-6">
        {
          STAYS.map((item) => (
            <div class="flex flex-wrap items-start gap-x-10 gap-y-1 border-t border-rule pt-5">
              <dt class="flex-1 basis-[240px] text-[15px] font-medium text-fg">{item.what}</dt>
              <dd
                class="m-0 flex-[2] basis-[420px] text-[14.5px] leading-[1.65] text-fg-dim text-pretty"
                set:html={item.body}
              />
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-16">
      <h2 class={h2}>Buying a licence</h2>
      {
        !SELLING && (
          <p class={lead}>
            Nothing is on sale yet. This is how a purchase will be handled once it is.
          </p>
        )
      }
      <p class={SELLING ? lead : prose}>
        Apart from anything you choose to write to us, this is the one place personal data exists at
        all, and it exists because a licence has to be deliverable and a refund has to be traceable to
        a sale.
      </p>
      <p class={prose}>
        Checkout is handled by Stripe, who take the payment details; this site never sees a card
        number. What is kept afterwards is your email address, the Stripe session and payment
        identifiers, and the licence issued against them. The email is used to send you the key and to
        find the licence again if you ask for it or a refund needs it. It is not used for anything
        else, and there is no mailing list to be added to.
      </p>
      <p class={prose}>
        The app itself never sends your email anywhere. A key is checked offline, so an installed copy
        has no idea who bought it.
      </p>
    </section>

    <section class="mt-16">
      <h2 id="this-site" class={h2}>This site</h2>
      <p class={lead}>
        Static files on Cloudflare, with no cookies and no third-party embeds. It loads no fonts and no
        images from anywhere else, and its content security policy refuses any request to an origin it
        does not name. Cloudflare keeps its own request logs, as any host does.
      </p>
      {
        CF_ANALYTICS_COUNTED ? (
          <p class={prose}>
            It counts page views with Cloudflare Web Analytics. That sets no cookie and stores nothing
            on your device, so there is no banner asking you to accept it. What it records is the page
            address, the referring page, your browser and operating system, your screen size, how long
            the page took to load, and the country the request came from. It never receives your IP
            address, and there is no identifier that would let one visit be joined to another or to
            you. Any content blocker stops it, and the page works unchanged without it.
          </p>
        ) : (
          <p class={prose}>It does not count page views today.</p>
        )
      }
      <p class={prose}>
        The <a href={FEEDBACK_URL} class={link}>feedback form</a> posts what you typed, and the four
        diagnostic fields shown beside it, to <code>{new URL(FEEDBACK_API).host}</code>, a small worker
        of ours. It does so only when you press Send, and keeps the report so it can be answered. The
        email address is optional and used only to reply to you. No other page on this site talks to
        it.
      </p>
    </section>

    <section class="mt-16">
      <h2 class={h2}>Asking</h2>
      <p class={lead}>
        To get a copy of what is held against your email, or to have it deleted, write to
        <a href={SUPPORT_EMAIL_HREF} class={link}>{SUPPORT_EMAIL}</a>. Deleting a purchase record
        ends the licence it belongs to, because the record is the licence.
      </p>
      <p class={prose}>
        If this page changes materially, the date at the top moves. The canonical copy lives at
        <a href={`${SITE_URL}/privacy`} class={link}>{SITE_URL}/privacy</a>.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
