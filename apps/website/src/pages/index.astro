---
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Gaps from "../components/Gaps.astro";
import Hero from "../components/Hero.astro";
import How from "../components/How.astro";
import Limits from "../components/Limits.astro";
import Marquee from "../components/Marquee.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import Problem from "../components/Problem.astro";
import Rules from "../components/Rules.astro";
import SiblingApps from "../components/SiblingApps.astro";
import Supervisor from "../components/Supervisor.astro";
import Vendors from "../components/Vendors.astro";
import Window from "../components/Window.astro";
import {
  APP_NAME,
  APP_VERSION,
  DOCS,
  DOWNLOAD,
  PRICING,
  REPO_PUBLIC,
  SHIPPED,
  SITE_URL,
  SUPPORT_EMAIL,
} from "../config";
import Layout from "../layouts/Layout.astro";

/** Publisher and site identity. `@id` lets the other schemas point at them. */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: "Magenta Creations",
  url: "https://mg-crea.com",
  email: SUPPORT_EMAIL,
  sameAs: ["https://mg-crea.com", "https://github.com/mgcrea"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: APP_NAME,
  url: SITE_URL,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "en",
};

/**
 * SoftwareApplication. `softwareVersion`, `downloadUrl` and `offers` appear only
 * once SHIPPED: a price in structured data is a claim the thing can be bought
 * right now, and a download URL before a release puts a 404 into search results.
 * `license` names the app's own source licence, and only once that URL answers.
 */
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 26",
  softwareRequirements: DOWNLOAD.requires,
  url: SITE_URL,
  description:
    "A macOS menu bar app for running many Claude Code and Codex sessions at once: session state, context window occupancy, 5-hour and 7-day plan limits with a pace forecast, and an opt-in read-only supervisor you can ask about the fleet. Read locally.",
  author: { "@type": "Person", name: "Olivier Louvignes" },
  publisher: { "@id": `${SITE_URL}/#organization` },
  ...(REPO_PUBLIC ? { license: DOCS.sourceLicense } : {}),
  ...(SHIPPED
    ? {
        softwareVersion: APP_VERSION,
        downloadUrl: `${SITE_URL}${DOWNLOAD.href}`,
        offers: {
          "@type": "Offer",
          price: PRICING.amount,
          priceCurrency: PRICING.currency,
          url: `${SITE_URL}${PRICING.buy}`,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

{/*
  The order is the argument: what it looks like, why it exists, how it works,
  what it adds, what it will not do, what it does not do yet, and only then the
  price. Known gaps sit before Pricing on purpose, so nobody learns them after
  paying.
*/}
<Layout schema={[organizationSchema, websiteSchema, schema]}>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <Marquee />
    <Window />
    <Problem />
    <How />
    <Limits />
    <Supervisor />
    <Rules />
    <Vendors />
    <Gaps />
    <Pricing />
    <SiblingApps />
    <Cta />
  </main>
  <Footer />
</Layout>
