---
/**
 * The price, what it buys, and the two separate ways to find out whether Armada
 * is for you before committing.
 *
 * The trial and the refund are not interchangeable and the copy must not blur
 * them. The trial answers "does this work with my accounts", which only running
 * it can answer. The refund answers "was it worth the money", asked afterwards.
 *
 * Buy is the filled button here and Download the outline, the hero's order
 * reversed: a reader who scrolled this far has read what it does.
 */
import { DOCS, DOWNLOAD, PRICING, REPO_PUBLIC, TRIAL } from "../config";
import AppleGlyph from "./AppleGlyph.astro";
import Button from "./Button.astro";
import SectionCopy from "./SectionCopy.astro";

const covers = PRICING.covers.replace(/^./, (c) => c.toUpperCase());

const INCLUDED = [
  {
    title: covers,
    body: "The key is issued to you, not to a machine, and nothing counts your installs. A 2.0, if there is one, would be a new purchase; nothing lapses in between.",
  },
  {
    title: "Verified offline, on your Mac",
    body: "A key is a signature the app checks locally. No activation call, no licence server, and nothing that refuses to start because a host is down.",
  },
  {
    title: `A free ${TRIAL.minutes}-minute trial of the whole app`,
    body: "Not a reduced version. Start it from a button when you are ready; nothing starts it on its own. Without a licence or a trial running, Armada watches nothing and says so.",
  },
  {
    title: `${PRICING.refundDays} days to change your mind`,
    body: "Full refund, no reason needed.",
  },
  ...(REPO_PUBLIC
    ? [
        {
          title: "The source stays readable",
          body: "What is sold is the signed, notarized build. An app that can see every agent you run should be readable by the people trusting it.",
        },
      ]
    : []),
];
---

<section id="pricing" class="scroll-mt-20 py-[96px]">
  <div class="wrap grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-16">
    <SectionCopy eyebrow="Price" heading="One price, one major version, every Mac you own.">
      <p class="m-0 text-[16px] leading-[1.6] text-pretty text-fg-dim">
        No subscription and no per-seat tier. Armada is a window onto files you already have, and
        charging rent for a menu bar app that reads your own disk is not a business this wants to be
        in.
      </p>
      <p class="m-0 text-[14px] leading-[1.6] text-pretty text-fg-muted">
        The trial answers whether Armada reads your accounts correctly. The refund answers whether it
        was worth the money, which is a different question, and asked second.
      </p>
    </SectionCopy>

    <div class="reveal relative">
      <div
        class="pointer-events-none absolute -inset-x-8 -top-10 h-[140px]"
        style="background:radial-gradient(70% 100% at 50% 0%,rgba(246,161,119,.13),transparent 72%)"
        aria-hidden="true"
      >
      </div>
      <div class="relative rounded-[16px] border border-rule bg-bg-2 p-6 sm:p-9">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span
            class="font-display text-[clamp(38px,6vw,54px)] leading-none font-semibold tracking-[-0.04em]"
          >
            {PRICING.price}
          </span>
          <span class="text-[14px] text-fg-dim">once, not a subscription</span>
        </div>
        {/* Both figures, because neither is a conversion of the other: the dollar
            price is quoted tax-exclusive and the euro one VAT-inclusive. Showing
            only the first would leave an EU buyer without the total they pay. */}
        <p class="mt-2 mb-0 text-[13.5px] leading-[1.6] text-fg-dim">
          {PRICING.eur.price} in the EU, VAT included.
        </p>

        <ul class="m-0 mt-7 flex list-none flex-col gap-5 p-0">
          {
            INCLUDED.map((item) => (
              <li class="flex gap-3">
                <span
                  class="mt-[7px] block size-1.5 flex-none rounded-full bg-accent"
                  aria-hidden="true"
                />
                <span class="flex flex-col gap-1">
                  <span class="text-[14.5px] font-medium text-fg">{item.title}</span>
                  <span class="text-[13.5px] leading-[1.6] text-pretty text-fg/50">{item.body}</span>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={PRICING.buy} size="lg" class="w-full sm:w-auto">
            Buy a licence <span class="opacity-70">·</span>
            {PRICING.price}
          </Button>
          <Button href={DOWNLOAD.href} variant="secondary" size="lg" class="w-full sm:w-auto">
            <AppleGlyph size={16} />
            Try it free
          </Button>
        </div>

        <p class="mt-6 mb-0 text-[13px] leading-[1.6] text-pretty text-fg-muted">
          The trial is held in memory, so quitting and reopening Armada starts another one. Nothing
          prevents that, and nothing pretends to. The{" "}
          <a href="/terms" class="text-fg-dim underline underline-offset-2 hover:text-accent-hi"
            >licence terms</a
          > set out the rest, including delivery of the key and the refund.{
            REPO_PUBLIC && (
              <>
                {" "}
                The{" "}
                <a
                  href={DOCS.sourceLicense}
                  class="text-fg-dim underline underline-offset-2 hover:text-accent-hi"
                >
                  source licence
                </a>{" "}
                covers the code.
              </>
            )
          }
        </p>
      </div>
    </div>
  </div>
</section>
