---
/**
 * The Magenta Creations "M", for the footer credit that links to mg-crea.com.
 *
 * Copied from cupertino's `MagentaMark.astro`, which copies it from
 * mgcrea-website's `design/mark.svg`. mgcrea-website is the authority on the mark
 * and nothing here checks the copies agree.
 *
 * - The right half is `currentColor`, so it takes the colour of the footer text
 *   beside it and cannot go invisible against the ground.
 * - The seam is a sliver of the ground, so it defaults to this site's background
 *   token rather than a hex.
 * - The clip-path ids are scoped by `uid`, because SVG ids are document-global.
 */
export interface Props {
  /** Rendered height in px; width follows the mark's own 64:52 ratio. */
  size?: number;
  /** Suffix for the clip-path ids. Change it if two marks share a page. */
  uid?: string;
  /** The gap between the halves. Defaults to this site's ground. */
  seam?: string;
  class?: string;
}

const { size = 15, uid = "mc", seam = "var(--color-bg, #0b0c0f)", class: className } = Astro.props;
const width = Math.round((size * 64) / 52);
---

<svg
  width={width}
  height={size}
  viewBox="18 24 64 52"
  fill="none"
  aria-hidden="true"
  class:list={className}
  style="display:block;flex:none"
>
  <defs>
    <clipPath id={`${uid}-l`}><rect x="18" y="24" width="32" height="52"></rect></clipPath>
    <clipPath id={`${uid}-r`}><rect x="50" y="24" width="32" height="52"></rect></clipPath>
  </defs>
  <path
    d="M18 76V24h11l21 25 21-25h11v52H71V42L50 67 29 42v34z"
    fill="#ff2e93"
    clip-path={`url(#${uid}-l)`}></path>
  <path
    d="M18 76V24h11l21 25 21-25h11v52H71V42L50 67 29 42v34z"
    fill="currentColor"
    clip-path={`url(#${uid}-r)`}></path>
  <path d="M49.45 48.345L50 49L50.55 48.345V66.345L50 67L49.45 66.345Z" fill={seam} opacity=".55"
  ></path>
</svg>
