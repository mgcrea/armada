---
/**
 * What 1.0 does not do, placed before the price on purpose: this section exists so
 * nobody finds these out after paying.
 *
 * Each item is in the tree. Messaging is the root README's "designed and not
 * started", folder
 * discovery is the README's Known gaps, and the terminal requirement is the
 * sentence Settings shows beside New Session (SettingsWindow.swift). An item that
 * ships comes off this list in the same commit.
 */
import SectionCopy from "./SectionCopy.astro";

const GAPS = [
  {
    badge: "designed",
    tone: "bg-warn/16 text-warn",
    title: "Messaging between agents",
    body: "Direct messages across accounts and vendors, with a router that decides delivery, an explicit policy per pair of agents, and an audit log. The architecture is written down. None of the code is.",
  },
  {
    badge: "known gap",
    tone: "bg-danger/16 text-danger-ink",
    title: "A new config folder needs a relaunch",
    body: "Folder discovery is not watched, so a <code>~/.claude-*</code> folder created while Armada is running appears the next time it starts.",
  },
  {
    badge: "by design",
    tone: "bg-fg-muted/20 text-fg-dim",
    title: "New Session needs Terminal or iTerm",
    body: "Starting a session hands your terminal a script to run, and not every terminal runs one it is handed. Watching works whatever the session runs in.",
  },
] as const;
---

<section id="status" class="scroll-mt-20 bg-linear-to-b from-bg to-bg-2 py-[96px]">
  <div class="wrap grid grid-cols-1 items-start gap-12 lg:grid-cols-2 lg:gap-16">
    <SectionCopy eyebrow="Known gaps" heading="What 1.0 does not do yet.">
      <p class="m-0 text-[16px] leading-[1.6] text-pretty text-fg-dim">
        Armada was designed around three features. Two of them ship in 1.0. The third, agents
        messaging each other across accounts and vendors, is designed and not started, and this
        section is here so nobody finds that out after paying.
      </p>
    </SectionCopy>

    <ul
      class="m-0 flex list-none flex-col gap-3.5 p-0 [&_code]:font-mono [&_code]:text-[0.9em] [&_code]:text-fg-dim"
    >
      {
        GAPS.map((g) => (
          <li class="reveal flex flex-col gap-2 rounded-[12px] border border-rule bg-bg-2 px-5 py-[18px] sm:flex-row sm:gap-3.5">
            <span
              class:list={[
                "self-start rounded-full px-[9px] py-[3px] font-mono text-[10px] whitespace-nowrap",
                g.tone,
              ]}
            >
              {g.badge}
            </span>
            <span class="flex flex-col gap-[5px]">
              <span class="text-[14px] font-medium">{g.title}</span>
              <span class="text-[13px] leading-[1.58] text-pretty text-fg-muted" set:html={g.body} />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
