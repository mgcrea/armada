---
/**
 * The main window, captured: accounts in the sidebar, the selected account's sessions
 * in the list, the selected session's detail beside it, and the actions a row offers
 * in the cards below.
 *
 * It used to be a drawing of the same thing, from data/fleet.ts. It is a capture now,
 * from the app's own demo mode (see `Capture`), full width because that is the only
 * width at which the window's own text is readable: at the old half-column it drew at
 * about half size. The list is one account's sessions, not every session on the Mac,
 * because that is what the window shows. Everything in the actions row is in
 * CHANGELOG.md's 1.0.0 section.
 */
import account from "../assets/screenshots/account.png";
import Capture from "./Capture.astro";
import SectionHeader from "./SectionHeader.astro";

/**
 * Five cards, laid out 3 + 2 on a six-column grid: the three things you do to a
 * session on the first row, the two that are not about a running session on the second.
 * `span` is the card's width on that grid; on the two-column breakpoint the last card
 * takes the whole row rather than leaving an orphan beside nothing.
 *
 * Continue on Another Account is CHANGELOG.md's 1.5.0 entry, and the toggle that makes it
 * stop at the copy is 1.7.0's. Claude Code only, as the action in the app is.
 */
const ACTIONS = [
  {
    title: "Focus",
    body: "Brings forward the app a session runs in, VS Code or a terminal, and its own window where Accessibility allows.",
    span: "lg:col-span-2",
  },
  {
    title: "Fork",
    body: "A copy of a session from where it stands, through the vendor's own fork command. The original is left alone.",
    span: "lg:col-span-2",
  },
  {
    title: "Continue on another account",
    body: "A Claude Code session stopped at one account's limit carries on under another. The conversation is copied there and opened in a terminal; the original keeps running, and its earlier turns stay counted where they were spent.",
    span: "lg:col-span-2",
  },
  {
    title: "New session",
    body: "Starts <code>claude</code>, <code>codex</code> or <code>grok</code> in a folder you pick, on the account you pick, in your own terminal.",
    span: "lg:col-span-3",
  },
  {
    title: "The menu bar",
    body: "A glyph that fills while anything works and rings when a session wants you. Star a plan limit to keep it beside the glyph.",
    span: "sm:col-span-2 lg:col-span-3",
  },
] as const;
---

<section id="fleet" class="scroll-mt-20 bg-linear-to-b from-bg-2 to-bg py-[96px]">
  <div class="wrap flex flex-col gap-12">
    <SectionHeader
      eyebrow="The window"
      heading="Every account in the sidebar. Every session one click away."
      class="mb-0!"
    >
      The account, one config folder, is the unit everything hangs off, because it is the unit the
      data is organised by. Two folders share nothing: separate sessions, separate transcripts,
      separate rate limits. So the sidebar is accounts, and each one lists what it is running,
      sorted by what needs you.
    </SectionHeader>

    <figure class="reveal m-0 flex flex-col gap-3">
      <Capture
        src={account}
        alt="Armada's main window: two Claude accounts and a Codex home in the sidebar, one account's sessions grouped by project with their state, and the selected session's state, actions and context window."
        sizes="(min-width: 1240px) 1160px, calc(100vw - 40px)"
        link
      />
      <figcaption class="font-mono text-[11px] text-fg-muted">
        A capture of the app in demo mode · accounts, sessions and figures are examples · a waiting
        session says what it wants, in Claude Code's own words
      </figcaption>
    </figure>

    <p class="m-0 max-w-[70ch] text-[14px] leading-[1.6] text-pretty text-fg-muted">
      Select a session and the detail pane shows its title, project, state and how full its context
      window is, where it started and when it was last compacted. Select nothing and you get the
      account itself: the folders it ran in last, one click each, and a tally of what its sessions
      are doing.
    </p>

    <ul
      class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-6 [&_code]:font-mono [&_code]:text-[0.9em] [&_code]:text-fg"
    >
      {
        ACTIONS.map((a) => (
          <li
            class:list={[
              "reveal flex flex-col gap-2 rounded-[12px] border border-rule bg-bg-2 p-5",
              a.span,
            ]}
          >
            <span class="text-[14.5px] font-semibold tracking-[-0.01em]">{a.title}</span>
            <span class="text-[13.5px] leading-[1.6] text-pretty text-fg-dim" set:html={a.body} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
