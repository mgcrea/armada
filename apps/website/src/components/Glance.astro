---
/**
 * The glance diagram: the three questions Armada answers, drawn in the page's own
 * card idiom.
 *
 * A diagram, not a screenshot, and it must not be dressed as one. There is no
 * capture pipeline for Armada yet, and a mock in window chrome would promise a
 * pane whose exact layout nobody has checked this against. What it shows is only
 * what the README and CHANGELOG say ships: per-account sessions with a
 * busy/waiting/idle state, context occupancy per session, the 5-hour and 7-day
 * windows with a pace line, Codex homes beside Claude accounts, and a menu bar
 * glyph that rings when a session wants you.
 *
 * The titles and every figure are invented examples, and the caption says so.
 * The glyph is the real one: `pnpm icons` copies it from design/.
 */
const SESSIONS = [
  { title: "Migrate the billing webhooks", state: "waiting", context: 71 },
  { title: "Fix the flaky auth test", state: "busy", context: 38 },
  { title: "Draft the release notes", state: "idle", context: 12 },
] as const;

const DOT = { waiting: "bg-warn", busy: "bg-ok", idle: "bg-fg-muted" } as const;
const INK = { waiting: "!text-warn", busy: "!text-ok-ink", idle: "" } as const;

/** `pace` is where the tick sits: how much of the window an even pace would have used by now. */
const LIMITS = [
  { label: "5-hour", used: 46, pace: 52, note: "resets in 2 h 10 min" },
  { label: "7-day", used: 63, pace: 57, note: "ahead of pace" },
] as const;
---

<figure class="m-0 flex flex-col gap-3">
  <div
    class="rounded-[16px] border border-rule bg-bg-2 p-5 shadow-[0_24px_60px_-34px_rgba(0,0,0,.9)] sm:p-6"
  >
    <div class="flex h-8 items-center justify-end gap-3 rounded-[9px] bg-chrome px-3">
      <span class="mono !text-[9.5px]">a session wants you</span>
      <img
        src="/menubar-glyph-halo.svg"
        alt=""
        width="18"
        height="18"
        class="template-glyph block size-[18px]"
      />
    </div>

    <div class="mt-5 flex items-baseline justify-between gap-3">
      <span class="font-mono text-[12.5px] text-fg">~/.claude</span>
      <span class="mono">Claude Code · 3 live</span>
    </div>

    <ul class="m-0 mt-3 flex list-none flex-col gap-2 p-0">
      {
        SESSIONS.map((s) => (
          <li class="rounded-[10px] border border-rule bg-bg-3 px-3.5 py-3">
            <div class="flex items-center gap-2.5">
              <span class:list={["block size-2 flex-none rounded-full", DOT[s.state]]} />
              <span class="flex-1 truncate text-[13.5px] text-fg">{s.title}</span>
              <span class:list={["mono flex-none", INK[s.state]]}>{s.state}</span>
            </div>
            <div class="mt-2.5 flex items-center gap-2.5">
              <span class="mono w-[58px] flex-none">context</span>
              <div class="h-[5px] flex-1 overflow-hidden rounded-full bg-rule">
                <div class="bar bg-accent" style={`width:${s.context}%`} />
              </div>
              <span class="w-9 flex-none text-right font-mono text-[11px] text-fg-dim">
                {s.context}%
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex flex-col gap-3.5 border-t border-rule pt-4">
      {
        LIMITS.map((l) => (
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <span class="text-[12.5px] text-fg">{l.label}</span>
              <span class="font-mono text-[11px] text-fg-dim">
                {l.used}% · {l.note}
              </span>
            </div>
            <div class="relative mt-1.5 h-[6px] rounded-full bg-rule">
              <div class="bar plate" style={`width:${l.used}%`} />
              <span
                class="absolute -top-[3px] block h-[12px] w-px bg-fg-dim"
                style={`left:${l.pace}%`}
                aria-hidden="true"
              />
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex items-baseline justify-between gap-3 border-t border-rule pt-4">
      <span class="font-mono text-[12.5px] text-fg">~/.codex</span>
      <span class="mono">Codex · 7-day 31%</span>
    </div>
  </div>
  <figcaption class="mono">Illustration · session names and figures are examples</figcaption>
</figure>
