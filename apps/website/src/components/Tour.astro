---
/**
 * The app, moving, at the head of `Gallery`.
 *
 * It sits there and not under the hero: a full-width loop as the first thing after
 * the H1 read as a promo reel. Here the main window has already been shown still in
 * `Window`, and the loop opens the section of captures as the same app in motion.
 * `make site-video` (apps/apple/Makefile, "Videos") renders it from the `tour` entry
 * in apps/apple/Screenshots/macos/screenshots.config.json, out of the same captures
 * `Window`, `Limits` and `Gallery` show still, and writes it to public/video. From
 * public/ and not astro:assets, which does nothing for video, so `make screenshots`
 * neither wipes nor refreshes it: it goes stale exactly when they do, and a capture
 * run wants a `make site-video` after it. The captions are burned in, so a claim
 * renamed on this page is still on screen in the old words until someone re-renders.
 *
 * `preload="none"` and no `autoplay`: the script below plays it only while it is on
 * screen, and not at all under reduced motion, where it stays on its poster with the
 * controls showing. The controls are the no-JS fallback too. Muted because it has no
 * sound to lose.
 *
 * Full width of the gallery's column, with the hero desktop's border and shadow, and
 * a caption in the tiles' own title-and-line shape. A figure, not a section: `Gallery`
 * places it and owns the spacing, and its closing line says the figures are examples.
 */
---

<figure class="reveal m-0 flex flex-col gap-3">
  <video
    data-tour
    src="/video/tour.mp4"
    poster="/video/tour.jpg"
    width="1920"
    height="1080"
    muted
    loop
    playsinline
    controls
    preload="none"
    aria-label="A twenty-second loop of Armada's window: the Usage pane's forecast for one account's week, an account's sessions with the one waiting on you picked out, a session's context window by category, and a Codex home in the same sidebar as the Claude accounts."
    class="block h-auto w-full rounded-[16px] border border-rule-2 bg-bg-2 shadow-[0_24px_60px_-34px_rgba(0,0,0,.9)]"
  >
  </video>
  <figcaption class="flex flex-col gap-1">
    <span class="text-[14.5px] font-semibold tracking-[-0.01em]">Twenty seconds of it, moving</span>
    <span class="text-[13.5px] leading-[1.6] text-pretty text-fg-dim">
      A week's forecast, the session waiting on you, a context window by category, and a Codex home
      beside the Claude accounts.
    </span>
  </figcaption>
</figure>

<script>
  // Plays the tour only while it is on screen. Reduced motion, or no
  // IntersectionObserver, leaves it as it rendered: paused, with controls.
  const tour = document.querySelector<HTMLVideoElement>("video[data-tour]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (tour && !still && "IntersectionObserver" in window) {
    tour.controls = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) void tour.play().catch(() => (tour.controls = true));
        else tour.pause();
      },
      { threshold: 0.4 },
    ).observe(tour);
  }
</script>
