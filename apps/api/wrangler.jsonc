{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0121e8859874c6fc0d674676e17d9f18",
  "name": "armada-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-15",
  "routes": [{ "pattern": "api.armada.mgcrea.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "armada-licenses",
      // Created 2026-09-14 with `wrangler d1 create armada-licenses` (WEUR).
      "database_id": "29f5a5e5-5022-4553-b743-34e38401f10a",
      "migrations_dir": "./migrations"
    }
  ],
  // Cloudflare Email Service. Sending to arbitrary recipients needs the Workers
  // Paid plan and a verified sender domain, or send() fails E_SENDER_NOT_VERIFIED.
  // mgcrea.io is already verified in this account for the other apps' Workers.
  "send_email": [{ "name": "EMAIL" }],
  // Per-address limits on the two routes anyone can call. `namespace_id` is any
  // integer unique within the ACCOUNT, not within this Worker, and the numbers
  // mean nothing beyond that. 1001-1002 and 2001-2004 are already held by other
  // Workers on this account (every wrangler.jsonc under ~/Projects/apps, checked
  // 2026-09-14), so this one takes 3001-3002 and its test environment 4001-4002.
  // The limiter is approximate and per-colo, which is the right tool here: it
  // bounds what a stranger can cost in D1 queries and outbound mail, it never
  // gates a customer doing the ordinary thing, and a limited request answers
  // the same way an unlimited one does so nothing is learned from being limited.
  "ratelimits": [
    { "name": "RESEND_LIMIT", "namespace_id": "3001", "simple": { "limit": 5, "period": 60 } },
    { "name": "THANKS_LIMIT", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "CURRENT_MAJOR": "1",
    // Which deployment this is. Anything but "test" is treated as production,
    // so a missing or misspelt value fails closed rather than open.
    "ENVIRONMENT": "production",
    // The price this Worker is allowed to fulfil, and the whole of the product
    // guard. EMPTY until the Stripe price exists: fill it in with the `price_…`
    // id, then `pnpm types` and `pnpm release`. While it is empty this Worker
    // refuses every sale, because every app on the Stripe account delivers its
    // checkouts to every Worker. See `handleWebhook` in src/index.ts.
    "EXPECTED_PRICE_ID": "price_1UFZiiFQJry8F0HMZCEwkkYf",
    "LICENSE_FROM_EMAIL": "licences@mgcrea.io",
    "SITE_URL": "https://armada.mgcrea.io"
  },
  // Workers Logs. Without it a fulfilment failure leaves no trace on this side
  // at all, and the only forensics is Stripe's own event log.
  "observability": { "enabled": true },
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,

  // The test-mode rehearsal, and the reason it is a named environment rather
  // than a second config file: secrets pushed without `--env` land on the
  // DEFAULT environment, which is the Worker taking real money. A test-mode
  // webhook secret there refuses every genuine payment as an invalid signature.
  //
  // Named environments inherit `main` and `compatibility_date` but NOT bindings
  // or vars, so those are repeated in full below rather than assumed. No custom
  // domain: a rehearsal is reached at its workers.dev URL, and the webhook
  // endpoint is whatever the test-mode Stripe dashboard is pointed at.
  "env": {
    "test": {
      "name": "armada-api-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "armada-licenses-test",
          "migrations_dir": "./migrations"
        }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "RESEND_LIMIT", "namespace_id": "4001", "simple": { "limit": 5, "period": 60 } },
        { "name": "THANKS_LIMIT", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } }
      ],
      // The one environment where an empty EXPECTED_PRICE_ID means unguarded
      // rather than closed. A test-mode Payment Link sells a test-mode price,
      // which is a different id from the live one, and pinning the wrong one
      // here would make the rehearsal refuse the very thing it exists to
      // rehearse. Pin the test-mode price once it exists: the sandbox is shared
      // by every app too, and unguarded this mints real arm1 keys (recorded
      // with livemode = 0) for the other apps' test purchases.
      "vars": {
        "CURRENT_MAJOR": "1",
        "ENVIRONMENT": "test",
        "EXPECTED_PRICE_ID": "",
        "LICENSE_FROM_EMAIL": "licences@mgcrea.io",
        "SITE_URL": "https://armada.mgcrea.io"
      },
      "observability": { "enabled": true },
      "send_metrics": false,
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
